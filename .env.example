# DeepSeek priority model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI fallback model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional app metadata
NEXT_PUBLIC_APP_NAME=Magic Agent

# Multi-source recommendation providers
VIDEO_PROVIDERS_ENABLED=youtube,bilibili,dailymotion,library
VIDEO_ALLOWED_DOMAINS=youtube.com,youtu.be,bilibili.com,vimeo.com,dailymotion.com,douyin.com,kuaishou.com
VIDEO_PROVIDER_TIMEOUT_MS=1200
VIDEO_PROVIDER_MAX_CANDIDATES=12
VIDEO_RECOMMEND_TOP_N=3
VIDEO_RECOMMEND_MIN_QUALITY=0.58
VIDEO_RECOMMEND_MIN_MATCH=0.5
VIDEO_RECOMMEND_CACHE_TTL_MS=30000
VIDEO_RECOMMEND_CONTEXT_CHARS=2400
VIDEO_VALIDATE_ACCESSIBILITY=true
VIDEO_VALIDATE_METADATA_STRICT=true

# Provider weights
VIDEO_PROVIDER_WEIGHT_YOUTUBE=1.3
VIDEO_PROVIDER_WEIGHT_BILIBILI=0.6
VIDEO_PROVIDER_WEIGHT_VIMEO=0.8
VIDEO_PROVIDER_WEIGHT_DAILYMOTION=0.95
VIDEO_PROVIDER_WEIGHT_LIBRARY=1.1

# Provider keys/base urls (fill only what you use)
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3/search
BILIBILI_API_KEY=
BILIBILI_API_BASE_URL=https://api.bilibili.com/x/web-interface/search/type
VIMEO_API_KEY=
VIMEO_API_BASE_URL=https://api.vimeo.com/videos
DAILYMOTION_API_KEY=
DAILYMOTION_API_BASE_URL=https://api.dailymotion.com/videos
DOUYIN_API_KEY=
DOUYIN_API_BASE_URL=
KUAISHOU_API_KEY=
KUAISHOU_API_BASE_URL=
